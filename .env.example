SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/<your-key>
WISP_MASTER_KEY=<64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
NEXT_PUBLIC_SITE_URL=https://wisp.example
# Where agents are told to send API, MCP and WebSocket traffic (same server, api. subdomain)
NEXT_PUBLIC_API_URL=https://api.wisp.example
DATABASE_URL=file:./data/wisp.db
# DATABASE_AUTH_TOKEN=
# PINATA_JWT=
# Treasury: the Wisp token's creator fees -> buybacks (agents keep 100% of their own coins' fees)
WISP_TREASURY_SECRET=<base58 64-byte secret of the treasury wallet>
# The official contract address. Shown in the CA box on the site once set.
WISP_TOKEN_MINT=
WISP_BUYBACK_BURN=true
WISP_BUYBACK_MIN_SOL=0.02
WISP_TREASURY_RESERVE_SOL=0.05
WISP_BUYBACK_INTERVAL_MIN=10
